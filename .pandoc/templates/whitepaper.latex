  \vspace{1.5cm}
  {\cybnohyph\centering\cybdisplayfont\fontsize{30}{35}\selectfont\color{white} $title$\par}
$if(subtitle)$
  \vspace{0.6cm}
  {\large\itshape\color{white!82!cyberblue} $subtitle$\par}
$endif$
