% Cybertechna white paper: gradient cover page, optional contents, long-form body, branded back page.
% Pandoc LaTeX template, engine lualatex. Shares cybertechna-common.latex.
% Metadata read: title, subtitle, header (line above the title), category (running header), series (footer),
% preparedby, author, date, audience, topcolor, bottomcolor, toc, toc-depth, numbersections, fontsize,
% nobackpage, backpage-title, backpage-text, nobio, author-bio, org.
\documentclass[$if(fontsize)$$fontsize$$else$12pt$endif$,letterpaper]{article}
\usepackage{xcolor}
\usepackage{amsmath,amssymb}
$if(numbersections)$
\setcounter{secnumdepth}{$if(secnumdepth)$$secnumdepth$$else$3$endif$}
$else$
\setcounter{secnumdepth}{-\maxdimen}
$endif$
$fonts.latex()$
\usepackage[$if(margin)$margin=$margin$$elseif(margin-x)$left=$margin-x$,right=$margin-x$,top=1in,bottom=1in$else$left=1.1in,right=1.1in,top=1in,bottom=1in$endif$,headheight=14pt,footskip=30pt]{geometry}
$common.latex()$
$cybertechna-common.latex()$
$for(header-includes)$
$header-includes$
$endfor$
$after-header-includes.latex()$
$hypersetup.latex()$
\hypersetup{colorlinks=true,linkcolor=darkblue,urlcolor=cyberblue,citecolor=cyberblue,filecolor=cyberblue,pdfborder={0 0 0},breaklinks=true}
\IfFileExists{xurl.sty}{\usepackage{xurl}}{}

\begin{document}
$for(include-before)$
$include-before$
$endfor$

% ---- Cover page ------------------------------------------------------------------------------------------
\begin{titlepage}
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    \shade[top color={$if(topcolor)$$topcolor$$else$darkblue$endif$}, bottom color={$if(bottomcolor)$$bottomcolor$$else$slate$endif$}, shading angle=45]
      (current page.north west) rectangle (current page.south east);
    \fill[cyberblue] ([yshift=-0.35cm]current page.north west) rectangle ([yshift=-0.55cm,xshift=0.45\paperwidth]current page.north west);
    \fill[cyberred] ([yshift=-0.35cm,xshift=0.45\paperwidth]current page.north west) rectangle ([yshift=-0.55cm,xshift=0.55\paperwidth]current page.north west);
  \end{tikzpicture}
  \centering
  \vspace*{1.5cm}
  {\color{white}\cybcapsfont\fontsize{9}{12}\selectfont\MakeUppercase{$header$}\par}
  \vspace{0.5cm}
