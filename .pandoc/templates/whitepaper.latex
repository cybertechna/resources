  \end{tcolorbox}\par
  \vspace{1cm}
  \begin{flushleft}
  \small\color{white!90}
$if(preparedby)$
  \textbf{Prepared by:} $preparedby$ \\
$endif$
  \textbf{Published:} $date$ \\
$if(audience)$
  \textbf{Target Audience:} $audience$
$endif$
  \end{flushleft}
\end{titlepage}

\pagenumbering{arabic}
