% Cybertechna slides: 16:9 pages (13.33 x 7.5 in), gradient title slide, optional section dividers, content slides, closing slide.
% Pandoc LaTeX template, engine lualatex. Shares cybertechna-common.latex.
% Metadata read: title, subtitle, author, date, audience, category, series, version, status, classification, org,
% closing (text of the last slide), closing-title, toc (an agenda slide), toc-depth, numbersections, fontsize,
% topcolor, bottomcolor, slide-sections (set by the filter), lead (printed under the title).
% A slide is a `##` heading (or `#` when the document uses one level). `# ` headings become divider slides when both are used.
\documentclass[12pt,letterpaper]{article}
\usepackage{xcolor}
\usepackage{amsmath,amssymb}
$if(numbersections)$
\setcounter{secnumdepth}{$if(secnumdepth)$$secnumdepth$$else$3$endif$}
$else$
\setcounter{secnumdepth}{-\maxdimen}
$endif$
$fonts.latex()$
\usepackage[paperwidth=13.333in,paperheight=7.5in,left=0.85in,right=0.85in,top=1.05in,bottom=0.85in,headheight=14pt,footskip=24pt]{geometry}
$common.latex()$
$cybertechna-common.latex()$
$for(header-includes)$
$header-includes$
$endfor$
$after-header-includes.latex()$
$hypersetup.latex()$
\hypersetup{colorlinks=true,linkcolor=darkblue,urlcolor=cyberblue,citecolor=cyberblue,filecolor=cyberblue,pdfborder={0 0 0},breaklinks=true}
\IfFileExists{xurl.sty}{\usepackage{xurl}}{}

\usepackage{paracol}
\setlength{\columnsep}{0.5in}
\newcommand{\cybdoctype}{$if(category)$$category$$elseif(doc-type)$$doc-type$$else$Slides$endif$}

% Larger type for a screen. The sizes the shared styles use (\small for tables, \footnotesize for wide tables) follow it.
\renewcommand{\normalsize}{\fontsize{24}{34}\selectfont}
\renewcommand{\small}{\fontsize{20}{28}\selectfont}
\renewcommand{\footnotesize}{\fontsize{17}{24}\selectfont}
\setlength{\parskip}{0.6em}
\setlength{\parindent}{0pt}
\setlist[itemize]{itemsep=0.35em,topsep=0.3em}
\setlist[enumerate]{itemsep=0.35em,topsep=0.3em}

% Every slide gets a thin brand strip along the top and a quiet footer.
\fancypagestyle{cyb}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyhead[L]{\begin{tikzpicture}[remember picture,overlay]
      \fill[darkblue] (current page.north west) rectangle ([yshift=-0.14in]current page.north east);
      \fill[cyberblue] (current page.north west) rectangle ([xshift=0.34\paperwidth,yshift=-0.14in]current page.north west);
      \fill[cyberred] ([xshift=0.34\paperwidth]current page.north west) rectangle ([xshift=0.40\paperwidth,yshift=-0.14in]current page.north west);
    \end{tikzpicture}}%
  \fancyfoot[L]{\color{cybermuted}\fontsize{12}{14}\selectfont\cybfootleft}%
  \fancyfoot[R]{\color{cybermuted}\fontsize{12}{14}\selectfont\thepage\ / \pageref*{LastPage}}%
}
\fancypagestyle{cybfirst}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{cybplain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\pagestyle{cyb}

\renewcommand{\cybeyebrow}[2][cyberblue]{{\noindent\color{cyberblue}\rule[2pt]{22pt}{3pt}\color{cyberred}\rule[2pt]{6pt}{3pt}\hspace{9pt}\color{#1}\cybcapsfont\fontsize{14}{16}\selectfont\MakeUppercase{#2}\par}}

% Slide title: new page, big navy heading, short blue-and-red rule.
\newcommand{\cybslidetitle}[1]{{\cybnohyph\cybheadfont\fontsize{40}{46}\selectfont\color{darkblue}#1\par}\nobreak\vspace{6pt}\nobreak{\noindent\color{cyberblue}\rule{54pt}{3pt}\color{cyberred}\rule{14pt}{3pt}\par}\nobreak\vspace{0.7em}}
% Divider slide: full-bleed navy with the section name large.
\newcommand{\cybdividerslide}[1]{%
  \thispagestyle{cybplain}%
  \vspace*{1.6in}%
  \begin{tikzpicture}[remember picture,overlay]
    \shade[left color=darkblue,right color=navyblue,shading angle=0] (current page.south west) rectangle (current page.north east);
    \fill[cyberblue] ([yshift=1.55in]current page.south west) rectangle ([xshift=0.45\paperwidth,yshift=1.62in]current page.south west);
    \fill[cyberred] ([xshift=0.45\paperwidth,yshift=1.55in]current page.south west) rectangle ([xshift=0.55\paperwidth,yshift=1.62in]current page.south west);
  \end{tikzpicture}%
  \par{\color{white}\cybnohyph\cybdisplayfont\fontsize{58}{64}\selectfont #1\par}}
$if(slide-sections)$
\titleformat{\section}{}{}{0pt}{\cybdividerslide}
\titlespacing*{\section}{0pt}{0pt}{0pt}
\titleformat{\subsection}{}{}{0pt}{\cybslidetitle}
\titlespacing*{\subsection}{0pt}{0pt}{0pt}
\titleformat{\subsubsection}{\cybnohyph\cybheadfont\fontsize{28}{34}\selectfont\color{cyberblue}}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.3em}
$else$
\titleformat{\section}{}{}{0pt}{\cybslidetitle}
\titlespacing*{\section}{0pt}{0pt}{0pt}
\titleformat{\subsection}{\cybnohyph\cybheadfont\fontsize{28}{34}\selectfont\color{cyberblue}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{0.8em}{0.3em}
$endif$
\renewcommand{\cftsecfont}{\fontsize{22}{30}\selectfont\bfseries\color{darkblue}}
\renewcommand{\cftsecpagefont}{\fontsize{22}{30}\selectfont\bfseries\color{darkblue}}

\newcommand{\cybtitleslide}{%
  \thispagestyle{cybplain}%
  \begin{tikzpicture}[remember picture,overlay]
    \shade[top color={$if(topcolor)$$topcolor$$else$darkblue$endif$}, bottom color={$if(bottomcolor)$$bottomcolor$$else$slate$endif$}, shading angle=45]
      (current page.south west) rectangle (current page.north east);
    \fill[cyberblue] ([yshift=0.0in]current page.south west) rectangle ([xshift=0.62\paperwidth,yshift=0.16in]current page.south west);
    \fill[cyberred] ([xshift=0.62\paperwidth]current page.south west) rectangle ([xshift=0.72\paperwidth,yshift=0.16in]current page.south west);
  \end{tikzpicture}%
  \vspace*{-0.35in}%
  \tcbox[on line,nobeforeafter,enhanced,frame hidden,boxrule=0pt,arc=6pt,colback=white,left=10pt,right=10pt,top=6pt,bottom=6pt]{\includegraphics[height=0.6in]{\cyblogobanner}}\par
  \vspace{0.45in}
  {\color{white}\cybeyebrow[white!70!cyberblue]{\cybdoctype}\vspace{0.7em}
  {\cybnohyph\cybdisplayfont\fontsize{50}{56}\selectfont $title$\par}
$if(subtitle)$
  \vspace{0.9em}{\fontsize{26}{36}\selectfont\color{white!82!darkblue}\begin{minipage}{0.8\linewidth}\raggedright $subtitle$\end{minipage}\par}
$endif$
$if(lead)$
  \vspace{0.8em}{\fontsize{20}{28}\selectfont\color{white!82!darkblue}\begin{minipage}{0.72\linewidth}\raggedright $lead$\end{minipage}\par}
$endif$
  \vfill
  {\fontsize{16}{22}\selectfont\color{white!85!darkblue}$for(author)$$author$$sep$, $endfor$$if(date)$\ \textperiodcentered\ $date$$endif$$if(audience)$\ \textperiodcentered\ $audience$$endif$\par}}
  \clearpage}

\begin{document}
$for(include-before)$
$include-before$
$endfor$
\cybtitleslide
$if(toc)$
\setcounter{tocdepth}{$if(toc-depth)$$toc-depth$$else$1$endif$}
\renewcommand{\contentsname}{$if(toc-title)$$toc-title$$else$Agenda$endif$}
{\hypersetup{linkcolor=darkblue}\cybslidetitle{\contentsname}\makeatletter\@starttoc{toc}\makeatother}
\clearpage
$endif$
$body$
$if(closing)$
\clearpage
\thispagestyle{cybplain}
\begin{tikzpicture}[remember picture,overlay]
  \shade[left color=darkblue,right color=navyblue,shading angle=0] (current page.south west) rectangle (current page.north east);
  \fill[cyberblue] ([yshift=1.55in]current page.south west) rectangle ([xshift=0.45\paperwidth,yshift=1.62in]current page.south west);
  \fill[cyberred] ([xshift=0.45\paperwidth,yshift=1.55in]current page.south west) rectangle ([xshift=0.55\paperwidth,yshift=1.62in]current page.south west);
\end{tikzpicture}
\vspace*{1.5in}
{\color{white}\cybeyebrow[white!70!cyberblue]{$if(closing-title)$$closing-title$$else$Next step$endif$}\vspace{0.7em}
{\cybnohyph\cybdisplayfont\fontsize{46}{54}\selectfont $closing$\par}
\vspace{1.2em}{\hypersetup{urlcolor=white}\fontsize{20}{26}\selectfont \href{mailto:info@cybertechna.com}{\nolinkurl{info@cybertechna.com}} \ \textperiodcentered\ \href{tel:8507371706}{850-737-1706}\par}}
$endif$
$for(include-after)$
$include-after$
$endfor$
\end{document}
