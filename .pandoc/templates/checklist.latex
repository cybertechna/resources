% Cybertechna checklist: navy title bar, optional fill-in fields, sections of tick boxes, optional sign-off block.
% Write items as task lists ("- [ ] Do the thing"; "- [x]" is printed already ticked). Tables with an empty column give a
% write-in column. Pandoc LaTeX template, engine lualatex. Shares cybertechna-common.latex.
% Metadata read: title, subtitle, lead, abstract (an "How to use" card), fields (list of labels printed as blank lines),
% signoff (list of roles for the sign-off block at the end), author, date, version, status, classification, category,
% series, toc, numbersections, fontsize, margin, margins, org.
\documentclass[$if(fontsize)$$fontsize$$else$10pt$endif$,letterpaper]{article}
\usepackage{xcolor}
\usepackage{amsmath,amssymb}
$if(numbersections)$
\setcounter{secnumdepth}{$if(secnumdepth)$$secnumdepth$$else$3$endif$}
$else$
\setcounter{secnumdepth}{-\maxdimen}
$endif$
$fonts.latex()$
\usepackage[$if(margin)$margin=$margin$$elseif(margin-x)$left=$margin-x$,right=$margin-x$,top=1in,bottom=1in$else$left=1in,right=1in,top=1in,bottom=1in$endif$,headheight=14pt,footskip=30pt]{geometry}
$common.latex()$
$cybertechna-common.latex()$
$for(header-includes)$
$header-includes$
$endfor$
$after-header-includes.latex()$
$hypersetup.latex()$
\hypersetup{colorlinks=true,linkcolor=darkblue,urlcolor=cyberblue,citecolor=cyberblue,filecolor=cyberblue,pdfborder={0 0 0},breaklinks=true}
\IfFileExists{xurl.sty}{\usepackage{xurl}}{}

\newcommand{\cybdoctype}{$if(category)$$category$$elseif(doc-type)$$doc-type$$else$Checklist$endif$}

% Sections in a checklist get a little more air before them and no big rule.
\titleformat{\section}{\cybnohyph\cybheadfont\fontsize{15}{18}\selectfont\color{darkblue}}{{\color{cyberblue}\thesection}}{0.6em}{}[\cybheadrule]
\titlespacing*{\section}{0pt}{1.8\baselineskip plus 0.4\baselineskip}{0.5\baselineskip}

\newcommand{\cybtitleblock}{%
  \thispagestyle{cybfirst}%
  \noindent\includegraphics[height=0.3in]{\cyblogosmall}\hfill{\color{cybermuted}\cybcapsfont\fontsize{6.5}{8}\selectfont\MakeUppercase{$if(classification)$$classification$$else$Cybertechna LLC$endif$}}\par
  \vspace{1em}
  \begin{tcolorbox}[enhanced,frame hidden,boxrule=0pt,sharp corners,
    interior style={left color=darkblue,right color=navyblue,shading angle=0},
    left=18pt,right=18pt,top=15pt,bottom=15pt,before skip=0pt,after skip=0pt,
    borderline west={5pt}{0pt}{cyberred}]
    \color{white}\cybeyebrow[white!70!cyberblue]{\cybdoctype}\vspace{0.6em}
    {\cybnohyph\cybdisplayfont\fontsize{22}{25}\selectfont $title$\par}
$if(subtitle)$
    \vspace{0.7em}{\fontsize{10.5}{15}\selectfont\color{white!78!darkblue}$subtitle$\par}
$endif$
  \end{tcolorbox}
  \vspace{0.6em}
  {\fontsize{8.5}{11}\selectfont
  \cybmeta{Updated}{$date$}%
  \cybmeta{Prepared by}{$for(author)$$author$$sep$, $endfor$}%
  \cybmeta{Version}{$version$}%
  \cybmeta{Status}{$status$}\par}
$if(lead)$
  \vspace{0.9em}\cyblead{$lead$}
$endif$
$if(fields-tex)$
  \vspace{1em}
  $fields-tex$
$endif$
$if(abstract)$
  \vspace{0.4em}
  \begin{cybnote}[$if(summary-title)$$summary-title$$else$How to use this checklist$endif$]
  $abstract$
  \end{cybnote}
$endif$
  \vspace{0.2em}
}

\begin{document}
$for(include-before)$
$include-before$
$endfor$
\cybtitleblock
$if(toc)$
{
\hypersetup{linkcolor=darkblue}
\setcounter{tocdepth}{$if(toc-depth)$$toc-depth$$else$1$endif$}
\renewcommand{\contentsname}{$if(toc-title)$$toc-title$$else$Contents$endif$}
\small\tableofcontents
}
$endif$
$body$
$if(signoff-tex)$

\Needspace{12\baselineskip}
\vspace{1.4em}
\cybeyebrow{Sign-off}\vspace{0.5em}

$signoff-tex$
$endif$
$for(include-after)$
$include-after$
$endfor$
\end{document}
